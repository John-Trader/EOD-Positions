{
  "name": "position-size-calculator",
  "version": "4.7.5",
  "description": "Position Size Calculator — Electron portable app with in-process TWS bridge",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "start": "node tools/run-dev.js",
    "dev": "node tools/run-dev.js",
    "icon": "node tools/make-icon.js",
    "build:css": "tailwindcss -c tailwind.config.js -i src/tw.css -o app.css",
    "dist": "npm run icon && electron-builder --win portable",
    "test": "node _run_tests.js"
  },
  "dependencies": {
    "@stoqey/ib": "^1.6.9",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.0.0",
    "sharp": "^0.35.0",
    "tailwindcss": "^3.4.19"
  }
}
